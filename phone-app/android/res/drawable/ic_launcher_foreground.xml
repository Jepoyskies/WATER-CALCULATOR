<?xml version="1.0" encoding="utf-8"?>
<!--
  The water drop, as a vector so it stays sharp at every icon size.

  It is a circle of radius 21 centred at (54, 62.5), with two straight lines
  running tangent to that circle and meeting at a point above it - exactly the
  shape the icon generator draws in Python.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,32.68 L68.90,47.71 A21,21 0 1 1 39.10,47.71 Z" />
</vector>
