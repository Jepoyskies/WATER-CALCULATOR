        <item name="android:statusBarColor">#025AA5</item>
        <item name="android:navigationBarColor">#F4F7F6</item>
        <item name="android:windowBackground">#F4F7F6</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">#0275D8</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
